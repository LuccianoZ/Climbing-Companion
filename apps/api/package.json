    "typeorm": "^1.1.0"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^13.2.1",
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.2.1",
    "@swc-node/register": "^1.12.1",
    "@swc/core": "^1.16.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
