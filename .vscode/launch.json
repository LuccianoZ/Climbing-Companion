{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Debug NestJS (apps/api)",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "start:debug", "-w", "apps/api"],
      "console": "integratedTerminal",
      "restart": true
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Debug Next.js (apps/web)",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "-w", "apps/web"],
      "console": "integratedTerminal",
      "env": { "NODE_OPTIONS": "--inspect" }
    }
  ]
}
